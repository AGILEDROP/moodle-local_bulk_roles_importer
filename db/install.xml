<?xml version="1.0" encoding="UTF-8" ?>
<XMLDB PATH="local/bulk_roles_importer/db" VERSION="20261116" COMMENT="XMLDB file for Moodle local/bulk_roles_importer"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:noNamespaceSchemaLocation="../../../lib/xmldb/xmldb.xsd"
>
  <TABLES>
    <TABLE NAME="local_bulk_roles_importer_rev" COMMENT="Last successfully applied Git revision of each role file">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="sourcekey" TYPE="char" LENGTH="40" NOTNULL="true" SEQUENCE="false" COMMENT="SHA1 of Git source and file path"/>
        <FIELD NAME="provider" TYPE="char" LENGTH="20" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="repository" TYPE="char" LENGTH="255" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="branch" TYPE="char" LENGTH="255" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="filepath" TYPE="text" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="revision" TYPE="char" LENGTH="64" NOTNULL="true" SEQUENCE="false" COMMENT="Blob ID of the last applied file version"/>
        <FIELD NAME="revisiontime" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="timemodified" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="roleid" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="allowtargets" TYPE="text" NOTNULL="false" SEQUENCE="false" COMMENT="JSON array of linked role IDs"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="sourcekey" UNIQUE="true" FIELDS="sourcekey"/>
      </INDEXES>
    </TABLE>
  </TABLES>
</XMLDB>
